<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Meu Divulga Ninja</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #0f0f0f;
            color: #e0e0e0;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            background-color: #1a1a1a;
            border: 1px solid #333;
            border-radius: 15px;
            padding: 2.5rem;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        .logo-section {
            text-align: center;
            margin-bottom: 2rem;
        }
        .logo-icon {
            font-size: 3rem;
            color: #0dcaf0;
            margin-bottom: 1rem;
        }
        .form-control {
            background-color: #262626;
            border: 1px solid #444;
            color: #fff;
            padding: 0.75rem 1rem;
        }
        .form-control:focus {
            background-color: #2d2d2d;
            border-color: #0dcaf0;
            color: #fff;
            box-shadow: 0 0 0 0.25rem rgba(13, 202, 240, 0.25);
        }
        .btn-primary {
            background: linear-gradient(45deg, #0dcaf0, #0d6efd);
            border: none;
            padding: 0.75rem;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .btn-primary:hover {
            opacity: 0.9;
        }
        .error-msg {
            background-color: rgba(220, 53, 69, 0.1);
            border: 1px solid #dc3545;
            color: #ea868f;
            padding: 0.75rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
            text-align: center;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="logo-section">
            <div class="logo-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h2 class="fw-bold h4 mb-0 text-white">Meu Divulga Ninja</h2>
            <p class="text-muted small">Área Restrita</p>
        </div>

        <% if (locals.error) { %>
            <div class="error-msg">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
            </div>
        <% } %>

        <form action="/login" method="POST">
            <div class="mb-3">
                <label class="form-label small text-muted">Usuário</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-muted">
                        <i class="bi bi-person"></i>
                    </span>
                    <input type="text" name="username" class="form-control" placeholder="Seu usuário" required>
                </div>
            </div>
            
            <div class="mb-4">
                <label class="form-label small text-muted">Senha</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-muted">
                        <i class="bi bi-key"></i>
                    </span>
                    <input type="password" name="password" class="form-control" placeholder="Sua senha" required>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">
                Entrar no Painel
            </button>
        </form>
    </div>

</body>
</html>
