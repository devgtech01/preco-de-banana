<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel - Meu Divulga Ninja</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body { background-color: #0d1117; color: #c9d1d9; font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif; }
        .sidebar { height: 100vh; background-color: #010409; color: white; padding-top: 20px; border-right: 1px solid #30363d;}
        .sidebar .nav-link { color: rgba(255,255,255,.75); padding: 12px 20px; font-weight: 500;}
        .sidebar .nav-link.active, .sidebar .nav-link:hover { color: white; background-color: #21262d; border-radius: 5px; }
        .main-content { padding: 40px; }
        .card { background-color: #161b22; border: 1px solid #30363d; border-radius: 12px; color: #c9d1d9;}
        .form-control { background-color: #010409; border: 1px solid #30363d; color: white; }
        .form-control:focus { background-color: #010409; color: white; border-color: #58a6ff; box-shadow: 0 0 0 0.25rem rgba(88, 166, 255, 0.25);}
        .form-label { font-weight: 500; font-size: 14px; }
        .text-muted { color: #8b949e !important; }
        .btn-primary { background-color: #238636; border-color: #2ea043; color: white; border-radius: 8px;}
        .btn-primary:hover { background-color: #2ea043; border-color: #2ea043;}
        .nav-pills .nav-link { color: #8b949e; font-weight: 600; border-radius: 8px;}
        .nav-pills .nav-link.active { background-color: #1f6feb; color: white;}
        /* Coupon Art Styles */
        #coupon-art-container { position: absolute; left: -9999px; top: -9999px; }
        .coupon-art { width: 600px; height: 400px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; position: relative; overflow: hidden; border-radius: 20px;}
        .coupon-art .bg-overlay { position: absolute; top:0; left:0; right:0; bottom:0; background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(0,0,0,0.5) 100%); z-index: 1;}
        .coupon-art-content { z-index: 2; position: relative; padding: 40px; background: rgba(0,0,0,0.4); border-radius: 20px; border: 2px dashed rgba(255,255,255,0.5); backdrop-filter: blur(10px);}
        .coupon-art-title { font-size: 38px; font-weight: 900; color: white; margin-bottom: 10px;text-transform: uppercase; letter-spacing: 2px;}
        .coupon-art-code { font-size: 60px; font-weight: 900; color: #fff; background: #e0284f; padding: 10px 40px; border-radius: 15px; display: inline-block; box-shadow: 0 10px 20px rgba(0,0,0,0.3); border: 4px solid white;}
        .coupon-art-store { font-size: 24px; color: #ddd; font-weight: 600; margin-bottom: 20px;}
    </style>
    <script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>
</head>
<body>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse">
            <div class="position-sticky">
                <h4 class="text-center mb-4 text-white fw-bold">
                    <i class="bi bi-robot text-primary"></i> MeuDivulga
                </h4>
                <ul class="nav flex-column gap-1">
                    <li class="nav-item"><a class="nav-link" href="#"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/"><i class="bi bi-megaphone me-2"></i> Gerar Promoção</a></li>
                    <li class="nav-item"><a class="nav-link" href="/settings"><i class="bi bi-globe me-2"></i> Minhas Afiliações</a></li>
                    <li class="nav-item mt-4 border-top border-secondary pt-2"><a class="nav-link text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i> Sair do Painel</a></li>
                </ul>

                <!-- MÉTRICAS DE SERVIDOR -->
                <div class="mt-4 px-3 border-top border-secondary pt-3">
                    <h6 class="text-muted fw-bold mb-3" style="font-size: 11px; letter-spacing: 1px;"><i class="bi bi-cpu"></i> STATUS DA VPS</h6>
                    
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small text-muted mb-1" style="font-size: 12px;">
                            <span>Uso de CPU</span>
                            <span id="cpuVal">--%</span>
                        </div>
                        <div class="progress" style="height: 4px; background-color: #30363d;">
                            <div id="cpuBar" class="progress-bar bg-success" role="progressbar" style="width: 0%"></div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small text-muted mb-1" style="font-size: 12px;">
                            <span>Memória VPS</span>
                            <span id="memVal">--%</span>
                        </div>
                        <div class="progress" style="height: 4px; background-color: #30363d;">
                            <div id="memBar" class="progress-bar bg-info" role="progressbar" style="width: 0%"></div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small text-muted mb-1" style="font-size: 12px;">
                            <span>RAM Isolada do Bot</span>
                            <span id="appMemVal" class="text-white">-- MB</span>
                        </div>
                    </div>
                </div>

            </div>
        </nav>

        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 main-content">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center mb-4">
                <h2 class="fw-bold text-white">Nova Promoção</h2>
            </div>

            <!-- Alertas -->
            <% if (success) { %>
                <div class="alert alert-success bg-success bg-opacity-10 border-success text-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            <% if (error) { %>
                <div class="alert alert-danger bg-danger bg-opacity-10 border-danger text-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-x-circle-fill me-2"></i> <%= error %>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- Formulário Sec Principal -->
            <div class="row">
                <div class="col-lg-12 mb-4" id="wa-auth-section" style="display: none;">
                    <div class="card bg-dark border-warning shadow">
                        <div class="card-body p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
                            <div>
                                <h5 class="text-warning fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Atenção: WhatsApp Desconectado!</h5>
                                <p class="text-muted mb-0">Para que as promoções cheguem aos seus grupos, você precisa vincular o WhatsApp novamente pelo aplicativo do seu celular.</p>
                            </div>
                            <div class="text-center rounded bg-white p-2" style="width: 150px; height: 150px; flex-shrink: 0;">
                                <img id="wa-qr-image" src="" alt="Gerando QR Code..." style="width: 100%; height: 100%; object-fit: contain;">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8 mb-4">
                    <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                      <li class="nav-item" role="presentation">
                        <button class="nav-link active w-100" id="pills-product-tab" data-bs-toggle="pill" data-bs-target="#pills-product" type="button" role="tab"><i class="bi bi-box-seam me-2"></i>Divulgar Produto</button>
                      </li>
                      <li class="nav-item ms-2" role="presentation">
                        <button class="nav-link w-100" id="pills-coupon-tab" data-bs-toggle="pill" data-bs-target="#pills-coupon" type="button" role="tab"><i class="bi bi-ticket-detailed me-2"></i>Apenas Cupom</button>
                      </li>
                    </ul>

                    <div class="tab-content" id="pills-tabContent">
                        <!-- ABA PRODUTO -->
                        <div class="tab-pane fade show active" id="pills-product" role="tabpanel" tabindex="0">
                            <div class="card shadow-sm h-100">
                                <div class="card-body p-4">
                                    <form action="/api/generate-preview" method="POST">
                                        <input type="hidden" name="mode" value="product">
                                        <div class="mb-3">
                                            <label for="url" class="form-label text-white mb-2"><i class="bi bi-link-45deg"></i> Link do Produto </label>
                                            <input type="url" class="form-control form-control-lg mb-2" id="url" name="url" placeholder="https://www.seu_link_afiliado.com.br/dp/B0CX..." required>
                                            <div class="text-muted small">
                                                <span>Cole o link original. A nossa máquina raspará os dados! ✨</span>
                                            </div>
                                        </div>

                                        <div class="mb-4">
                                            <label for="coupon" class="form-label text-white mb-2"><i class="bi bi-ticket-perforated"></i> Cupom de Desconto (Opcional)</label>
                                            <input type="text" class="form-control form-control-lg mb-2" id="coupon" name="coupon" placeholder="Ex: NINJA10">
                                            <div class="text-muted small">
                                                Se preenchido, o código será anexado na formatação final da postagem.
                                            </div>
                                        </div>
                                        
                                        <button type="submit" class="btn btn-primary px-4 py-2 fw-bold w-100 w-md-auto">
                                            <i class="bi bi-eye-fill me-2"></i> Analisar e Gerar Prévia
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- ABA CUPOM -->
                        <div class="tab-pane fade" id="pills-coupon" role="tabpanel" tabindex="0">
                            <div class="card shadow-sm h-100">
                                <div class="card-body p-4">
                                    <form id="couponForm" action="/api/generate-preview" method="POST">
                                        <input type="hidden" name="mode" value="coupon">
                                        <input type="hidden" id="couponImageBase64" name="imageBase64" value="">
                                        
                                        <div class="mb-3">
                                            <label class="form-label text-white mb-2"><i class="bi bi-shop"></i> Loja</label>
                                            <select class="form-control form-control-lg mb-2" id="storeSelect" name="storeName" required>
                                                <option value="" disabled selected>Escolha a plataforma</option>
                                                <option value="Magalu">Magalu</option>
                                                <option value="Shopee">Shopee</option>
                                                <option value="Mercado Livre">Mercado Livre</option>
                                                <option value="Amazon">Amazon</option>
                                                <option value="AliExpress">AliExpress</option>
                                                <option value="KaBuM!">KaBuM!</option>
                                            </select>
                                        </div>

                                        <div class="mb-4">
                                            <label for="couponOnlyCode" class="form-label text-white mb-2"><i class="bi bi-ticket-detailed-fill"></i> Código do Cupom</label>
                                            <input type="text" class="form-control form-control-lg mb-2" id="couponOnlyCode" name="coupon" placeholder="Ex: MAGALU10" required>
                                        </div>
                                        
                                        <button type="button" onclick="generateCouponArt()" class="btn btn-primary px-4 py-2 fw-bold w-100 w-md-auto" id="btnGenCoupon">
                                            <i class="bi bi-magic me-2"></i> Criar Arte e Gerar Prévia
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm border-0 border-start border-4 border-primary">
                        <div class="card-body p-4">
                            <h5 class="card-title fw-bold text-white mb-3"><i class="bi bi-info-circle text-primary me-2"></i>Instruções Básicas</h5>
                            <p class="card-text text-muted mb-3">O seu link será completamente convertido para o seu Link Oficial de Afiliado configurado antes de postar no grupo.</p>
                            
                            <h6 class="fw-bold fs-6 mt-4 text-white">Como Usar:</h6>
                            <ul class="text-muted small ps-3">
                                <li class="mb-2">Acesse <b>Minhas Afiliações</b> ali na aba lateral</li>
                                <li class="mb-2">Cadastre e salve sua Tag de Associado</li>
                                <li class="mb-2">Volte aqui e cole o link comum do produto</li>
                                <li>Nós baixamos a foto, os preços originais e enviamos para seu Grupo!</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- Div Invisível para Geração da Arte -->
<div id="coupon-art-container">
    <div id="captureArt" class="coupon-art">
        <div class="bg-overlay"></div>
        <div class="coupon-art-content">
            <div class="coupon-art-store" id="artStore">Loja</div>
            <div class="coupon-art-title">Cupom Liberado</div>
            <div class="coupon-art-code" id="artCode">CUPOM</div>
        </div>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
async function generateCouponArt() {
    const store = document.getElementById('storeSelect').value;
    const code = document.getElementById('couponOnlyCode').value;
    
    if(!store || !code) return alert('Selecione a loja e digite o cupom!');

    const btn = document.getElementById('btnGenCoupon');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Desenhando Arte...';

    // Configurar layout e cores
    const art = document.getElementById('captureArt');
    document.getElementById('artStore').innerText = store;
    document.getElementById('artCode').innerText = code.toUpperCase();
    
    let bgColor = '#333';
    if(store === 'Magalu') bgColor = '#0086ff'; // Azul Magalu
    if(store === 'Shopee') bgColor = '#ee4d2d'; // Laranja Shopee
    if(store === 'Mercado Livre') bgColor = '#ffe600'; // Amarelo ML
    if(store === 'Amazon') bgColor = '#232f3e'; // Azul escuro Amazon
    if(store === 'AliExpress') bgColor = '#e62e04'; // Vermelho Ali
    if(store === 'KaBuM!') bgColor = '#0b2ea1'; // Azul KaBuM!
    
    art.style.backgroundColor = bgColor;
    
    // Trocar cor do texto se for amarelo (pra dar contraste)
    if(store === 'Mercado Livre') {
        document.getElementById('artStore').style.color = '#333';
        document.querySelector('.coupon-art-title').style.color = '#333';
        document.querySelector('.coupon-art-code').style.color = '#fff';
        document.querySelector('.coupon-art-code').style.backgroundColor = '#333';
        document.querySelector('.coupon-art-content').style.borderColor = 'rgba(0,0,0,0.5)';
        document.querySelector('.coupon-art-content').style.background = 'rgba(255,255,255,0.4)';
    } else {
        document.getElementById('artStore').style.color = '#ddd';
        document.querySelector('.coupon-art-title').style.color = 'white';
        document.querySelector('.coupon-art-code').style.color = '#fff';
        document.querySelector('.coupon-art-code').style.backgroundColor = '#e0284f';
        document.querySelector('.coupon-art-content').style.borderColor = 'rgba(255,255,255,0.5)';
        document.querySelector('.coupon-art-content').style.background = 'rgba(0,0,0,0.4)';
    }

    try {
        // Renderizar com html2canvas
        const canvas = await html2canvas(art, { scale: 2 }); // Scale 2 para alta resolução
        const base64Image = canvas.toDataURL('image/jpeg', 0.9);
        
        // Injetar no form e submit
        document.getElementById('couponImageBase64').value = base64Image;
        document.getElementById('couponForm').submit();
    } catch (e) {
        alert('Erro ao gerar a arte do cupom. Verifique seu navegador.');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-magic me-2"></i> Criar Arte e Gerar Prévia';
    }
}

// Lógica para capturar Métricas do Sistema
function fetchMetrics() {
    fetch('/api/metrics')
        .then(response => response.json())
        .then(data => {
            document.getElementById('cpuVal').innerText = data.cpuPercent + '%';
            document.getElementById('cpuBar').style.width = data.cpuPercent + '%';
            
            // Mudar cor do bar conforme severidade
            const cpuBar = document.getElementById('cpuBar');
            cpuBar.className = 'progress-bar ' + (data.cpuPercent > 80 ? 'bg-danger' : data.cpuPercent > 50 ? 'bg-warning' : 'bg-success');

            document.getElementById('memVal').innerText = data.memPercent + '%';
            document.getElementById('memBar').style.width = data.memPercent + '%';
            
            const memBar = document.getElementById('memBar');
            memBar.className = 'progress-bar ' + (data.memPercent > 85 ? 'bg-danger' : 'bg-info');

            document.getElementById('appMemVal').innerText = data.appMemMB + ' MB';

            // LÓGICA DO QR CODE E STATUS WHATSAPP
            const waAuthSection = document.getElementById('wa-auth-section');
            const waQrImage = document.getElementById('wa-qr-image');

            if (!data.waConnected) {
                waAuthSection.style.display = 'block';
                if (data.waQrUrl) {
                    waQrImage.src = data.waQrUrl;
                }
            } else {
                waAuthSection.style.display = 'none';
            }
        })
        .catch(err => console.error('Erro na carga de métricas', err));
}

// Inicia as métricas e atualiza a cada 5 segundos
fetchMetrics();
setInterval(fetchMetrics, 5000);
</script>
</body>
</html>
