<!-- Modal Mercado Livre -->
<div class="modal fade" id="modalML" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form action="/settings" method="POST">
          <div class="modal-header">
            <h5 class="modal-title fw-bold">Configurar Mercado Livre</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
                <label class="form-label">Link de Afiliado</label>
                <input type="text" class="form-control" name="mlAffiliateLink" value="<%= settings.mlAffiliateLink %>" placeholder="Cole seu link geral de afiliado do ML">
            </div>
            <div class="mb-3">
                <label class="form-label">Link ou modelo de afiliado</label>
