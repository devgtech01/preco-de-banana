<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configurações - Meu Divulga Ninja</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body { background-color: #0d1117; color: #c9d1d9; font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif; }
        .sidebar { height: 100vh; background-color: #010409; color: white; padding-top: 20px; border-right: 1px solid #30363d;}
        .sidebar .nav-link { color: rgba(255,255,255,.75); padding: 12px 20px; font-weight: 500;}
        .sidebar .nav-link.active, .sidebar .nav-link:hover { color: white; background-color: #21262d; border-radius: 5px; }
        .main-content { padding: 40px; }
        /* Style dos Cards de Loja */
        .store-card { background-color: #161b22; border: 1px solid #30363d; border-radius: 12px; text-align: center; padding: 25px 20px; transition: transform 0.2s;}
        .store-card:hover { border-color: #8b949e; }
        .store-logo { width: 60px; height: 60px; border-radius: 10px; margin: 0 auto 15px; background: #0d1117; border: 1px solid #30363d; display: flex; align-items: center; justify-content: center; font-size: 30px; line-height: 1;}
        .status-badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 12px; margin-bottom: 20px; font-weight: 600;}
        .status-pendente { background-color: rgba(210, 153, 34, 0.15); color: #d29922; border: 1px solid rgba(210, 153, 34, 0.4);}
        .status-pronto { background-color: rgba(46, 160, 67, 0.15); color: #2ea043; border: 1px solid rgba(46, 160, 67, 0.4);}
        .btn-config { background-color: #21262d; border: 1px solid #30363d; color: #c9d1d9; width: 100%; font-weight: 600; padding: 8px;}
        .btn-config:hover { background-color: #30363d; color: white;}
        /* Modais */
        .modal-content { background-color: #161b22; border: 1px solid #30363d; color: #c9d1d9;}
        .modal-header { border-bottom: 1px solid #30363d; }
        .modal-footer { border-top: 1px solid #30363d; }
        .form-control, .form-select { background-color: #010409; border: 1px solid #30363d; color: white; }
        .form-control:focus, .form-select:focus { background-color: #010409; color: white; border-color: #58a6ff; box-shadow: 0 0 0 0.25rem rgba(88, 166, 255, 0.25);}
        .form-label { font-weight: 500; font-size: 14px; }
        .text-muted { color: #8b949e !important; }
        .card-canal { background-color: #161b22; border: 1px solid #30363d; border-radius: 12px; padding: 25px; }
    </style>
</head>
<body>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse">
            <div class="position-sticky">
                <h4 class="text-center mb-4 text-white fw-bold">
                    <i class="bi bi-robot text-primary"></i> MeuDivulga
                </h4>
                <ul class="nav flex-column gap-1">
                    <li class="nav-item"><a class="nav-link" href="#"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/"><i class="bi bi-megaphone me-2"></i> Gerar Promoção</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/settings"><i class="bi bi-globe me-2"></i> Minhas Afiliações</a></li>
                    <li class="nav-item mt-4 border-top border-secondary pt-2"><a class="nav-link text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i> Sair do Painel</a></li>
                </ul>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 main-content">
            <div class="mb-5">
                <h2 class="fw-bold text-white">Minhas Afiliações</h2>
                <p class="text-muted">Conecte suas plataformas e em seguida vá em "Gerar Promoção" para automatizar seus links.</p>
            </div>

            <!-- Alertas -->
            <% if (success) { %>
                <div class="alert alert-success bg-success bg-opacity-10 border-success text-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <% if (error) { %>
                <div class="alert alert-danger bg-danger bg-opacity-10 border-danger text-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!--
              Grid e modais saem de `lojas` (afiliados.js > esquemaDeAfiliados).
              Antes cada loja tinha o seu card e o seu modal escritos na mão:
              acrescentar uma sexta loja significava copiar ~40 linhas de HTML e
              lembrar de todos os campos. Agora registrar a loja no afiliados.js
              cria a coluna no banco E a tela, de uma vez.
            -->
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
                <% lojas.forEach(function(loja) { %>
                    <%
                        // "Configurada" = qualquer campo preenchido. Simples de
                        // propósito: a regra antiga variava por loja e ficava
                        // dessincronizada dos campos que a tela realmente tinha.
                        const preenchida = loja.campos.some(function(c) { return settings[c.nome]; });
                    %>
                    <div class="col">
                        <div class="store-card">
                            <div class="store-logo"><%= loja.rotulo.split(' ')[0] %></div>
                            <h5 class="fw-bold mb-1 text-white"><%= loja.nome %></h5>
                            <% if (preenchida) { %>
                                <div class="status-badge status-pronto">Configurado</div>
                            <% } else { %>
                                <div class="status-badge status-pendente">Pendente</div>
                            <% } %>
                            <button class="btn btn-config" data-bs-toggle="modal" data-bs-target="#modal-<%= loja.chave %>">
                                <i class="bi bi-gear me-2"></i> Configurar
                            </button>
                        </div>
                    </div>
                <% }); %>
            </div>

            <!-- ============ CANAIS DE TRANSMISSÃO ============ -->
            <h4 class="fw-bold text-white mt-5 mb-3">Canais de transmissão</h4>
            <div class="card-canal">
                <form action="/settings" method="POST">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">
                                <i class="bi bi-whatsapp text-success me-1"></i> Grupo do WhatsApp
                            </label>
                            <!--
                              Lista em vez de campo livre: descobrir um JID como
                              "120363406538141998@g.us" e digitá-lo sem errar era
                              a parte mais fácil de errar da configuração inteira.
                              O campo de texto continua aí para quem já tem o ID.
                            -->
                            <div class="input-group mb-2">
                                <select class="form-select" id="listaGrupos" disabled>
                                    <option>Carregando grupos…</option>
                                </select>
                                <button class="btn btn-outline-secondary" type="button" id="btnRecarregarGrupos" title="Recarregar">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </div>
                            <input type="text" class="form-control" name="whatsappGroupId" id="campoGrupo"
                                   value="<%= settings.whatsappGroupId || '' %>"
                                   placeholder="Ex: 120363406538141998@g.us">
                            <div class="form-text text-muted">Escolha na lista acima ou cole o ID.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">
                                <i class="bi bi-send text-info me-1"></i> Canal / grupo do Telegram
                            </label>
                            <input type="text" class="form-control mb-2" name="telegramChatId"
                                   value="<%= settings.telegramChatId || '' %>" placeholder="Ex: @MeuCanal">
                            <label class="form-label">Token do bot do Telegram</label>
                            <input type="password" class="form-control" name="telegramBotToken"
                                   value="<%= settings.telegramBotToken || '' %>" placeholder="Token do @BotFather">
                            <div class="form-text text-muted">Deixe o token como está para não alterá-lo.</div>
                        </div>
                    </div>
                    <div class="text-end mt-3">
                        <button type="submit" class="btn btn-primary fw-bold px-4">Salvar canais</button>
                    </div>
                </form>
            </div>
        </main>
    </div>
</div>

<!-- ================= MODAIS DAS LOJAS ================= -->
<% lojas.forEach(function(loja) { %>
<div class="modal fade" id="modal-<%= loja.chave %>" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form action="/settings" method="POST">
          <div class="modal-header">
            <h5 class="modal-title fw-bold">Configurar <%= loja.nome %></h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <% if (loja.aviso) { %>
                <div class="alert alert-dark border-secondary small py-2">
                    <i class="bi bi-info-circle me-1 text-info"></i> <%= loja.aviso %>
                </div>
            <% } %>
            <% loja.campos.forEach(function(campo) { %>
                <div class="mb-3">
                    <label class="form-label"><%= campo.rotulo %></label>
                    <input type="<%= campo.tipo %>" class="form-control" name="<%= campo.nome %>"
                           value="<%= settings[campo.nome] || '' %>"
                           placeholder="<%= campo.placeholder || '' %>">
                    <% if (campo.ajuda) { %>
                        <div class="form-text text-muted"><%= campo.ajuda %></div>
                    <% } %>
                </div>
            <% }); %>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary">Salvar</button>
          </div>
      </form>
    </div>
  </div>
</div>
<% }); %>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Preenche a lista de grupos do WhatsApp. Falhar aqui não pode atrapalhar:
    // o campo de texto continua valendo e o formulário salva do mesmo jeito.
    (async function carregarGrupos() {
        const lista = document.getElementById('listaGrupos');
        const campo = document.getElementById('campoGrupo');

        async function carregar() {
            lista.disabled = true;
            lista.innerHTML = '<option>Carregando grupos…</option>';
            try {
                const resposta = await fetch('/api/wa-groups');
                const dados = await resposta.json();

                if (!dados.success || !dados.grupos.length) {
                    lista.innerHTML = '<option value="">'
                        + (dados.error || 'Nenhum grupo encontrado') + '</option>';
                    return;
                }

                lista.innerHTML = '<option value="">— escolha um grupo —</option>';
                for (const grupo of dados.grupos) {
                    const opcao = document.createElement('option');
                    opcao.value = grupo.id;
                    opcao.textContent = grupo.nome + ' (' + grupo.participantes + ')';
                    if (grupo.id === campo.value) opcao.selected = true;
                    lista.appendChild(opcao);
                }
                lista.disabled = false;
            } catch (err) {
                lista.innerHTML = '<option value="">Bot indisponível</option>';
            }
        }

        lista.addEventListener('change', function () {
            if (lista.value) campo.value = lista.value;
        });
        document.getElementById('btnRecarregarGrupos').addEventListener('click', carregar);

        carregar();
    })();
</script>
</body>
</html>
