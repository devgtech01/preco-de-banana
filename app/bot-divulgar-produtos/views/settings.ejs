            </div>
            <div class="mb-3">
                <label class="form-label">Parâmetros extras (opcional)</label>
                <input type="text" class="form-control" name="mlAffiliateParams" value="<%= settings.mlAffiliateParams %>" placeholder="Ex: sub_id=grupo-whatsapp">
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Voltar</button>
