</div>

<!-- Modal Magalu -->
<div class="modal fade" id="modalMagalu" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form action="/settings" method="POST">
          <div class="modal-header">
            <h5 class="modal-title fw-bold text-primary">Configurar Magalu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
                <label class="form-label">Seu Link Afiliado Genérico Magalu</label>
                <input type="text" class="form-control" name="magaluAffiliateLink" value="<%= settings.magaluAffiliateLink %>" placeholder="Ex: https://www.magazinevoce.com.br/magazineSEUNOME/">
                <div class="text-muted small mt-2">Usado como link base genérico quando postar apenas cupons ou não for possível embutir no produto.</div>
            </div>
            <div class="mb-3">
                <label class="form-label">Link ou modelo de afiliado</label>
                <input type="text" class="form-control" name="magaluAffiliateTemplate" value="<%= settings.magaluAffiliateTemplate %>" placeholder="Opcional: deeplink com {url}">
                <div class="text-muted small mt-2">
                    Com <code>{url}</code> no meio, o endereço do produto entra no lugar (deeplink de rede de afiliados).
                    Sem <code>{url}</code>, o link salvo substitui o do produto. Em branco, publica o link original da loja.
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Parâmetros extras (opcional)</label>
                <input type="text" class="form-control" name="magaluAffiliateParams" value="<%= settings.magaluAffiliateParams %>" placeholder="Ex: sub_id=grupo-whatsapp">
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Voltar</button>
            <button type="submit" class="btn btn-primary">Salvar</button>
          </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal KaBuM! -->
<div class="modal fade" id="modalKabum" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form action="/settings" method="POST">
          <div class="modal-header">
            <h5 class="modal-title fw-bold">Configurar KaBuM!</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="alert alert-dark border-secondary small">
                <i class="bi bi-info-circle me-1"></i>
                O programa de afiliados da KaBuM! roda por rede (Awin/Rakuten): cole aqui o
                deeplink que a rede gera, com <code>{url}</code> no lugar do endereço do produto.
            </div>
            <div class="mb-3">
                <label class="form-label">Link ou modelo de afiliado</label>
                <input type="text" class="form-control" name="kabumAffiliateTemplate" value="<%= settings.kabumAffiliateTemplate %>" placeholder="Ex: https://www.awin1.com/cread.php?awinmid=00000&awinaffid=00000&ued={url}">
                <div class="text-muted small mt-2">
                    Com <code>{url}</code> no meio, o endereço do produto entra no lugar (deeplink de rede de afiliados).
                    Sem <code>{url}</code>, o link salvo substitui o do produto. Em branco, publica o link original da loja.
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Parâmetros extras (opcional)</label>
                <input type="text" class="form-control" name="kabumAffiliateParams" value="<%= settings.kabumAffiliateParams %>" placeholder="Ex: sub_id=grupo-whatsapp">
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Voltar</button>
            <button type="submit" class="btn btn-primary">Salvar</button>
          </div>
      </form>
    </div>
  </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
