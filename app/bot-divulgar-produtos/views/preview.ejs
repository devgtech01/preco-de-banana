<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prévia - Meu Divulga Ninja</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body { background-color: #0d1117; color: #c9d1d9; font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif; }
        .sidebar { height: 100vh; background-color: #010409; color: white; padding-top: 20px; border-right: 1px solid #30363d;}
        .sidebar .nav-link { color: rgba(255,255,255,.75); padding: 12px 20px; font-weight: 500;}
        .sidebar .nav-link.active, .sidebar .nav-link:hover { color: white; background-color: #21262d; border-radius: 5px; }
        .main-content { padding: 40px; }
        .card { background-color: #161b22; border: 1px solid #30363d; border-radius: 12px; color: #c9d1d9;}
        .form-control { background-color: #010409; border: 1px solid #30363d; color: white; }
        .form-control:focus { background-color: #010409; color: white; border-color: #58a6ff; box-shadow: 0 0 0 0.25rem rgba(88, 166, 255, 0.25);}
        .btn-success { background-color: #238636; border-color: #2ea043; color: white; border-radius: 8px;}
        .btn-success:hover { background-color: #2ea043; border-color: #2ea043;}
    </style>
</head>
<body>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse">
            <div class="position-sticky">
                <h4 class="text-center mb-4 text-white fw-bold">
                    <i class="bi bi-robot text-primary"></i> MeuDivulga
                </h4>
                <ul class="nav flex-column gap-1">
                    <li class="nav-item"><a class="nav-link" href="#"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/"><i class="bi bi-megaphone me-2"></i> Gerar Promoção</a></li>
                    <li class="nav-item"><a class="nav-link" href="/settings"><i class="bi bi-globe me-2"></i> Minhas Afiliações</a></li>
                    <li class="nav-item mt-4 border-top border-secondary pt-2"><a class="nav-link text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i> Sair do Painel</a></li>
                </ul>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 main-content">
            <div class="mb-4 d-flex justify-content-between align-items-center">
                <h2 class="fw-bold text-white"><i class="bi bi-eye-fill text-warning me-2"></i>Revisão da Promoção</h2>
                <a href="/" class="btn btn-outline-secondary text-white border-secondary">Cancelar e Voltar</a>
            </div>

            <div class="row">
                <div class="col-lg-12 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body p-4">
                            <form action="/api/confirm-send" method="POST">
                                <div class="row">
                                    <div class="col-md-4 text-center mb-4 mb-md-0 d-flex flex-column" style="min-height: 400px;">
                                        <!-- Preview da Imagem -->
                                        <div style="background-color: white; border-radius: 8px; flex: 1; display:flex; justify-content:center; align-items:center; overflow:hidden;" class="p-2 mb-3 shadow">
                                            <img src="<%= product.image %>" style="max-width: 100%; max-height: 100%; object-fit: contain;" alt="Imagem do Produto">
                                        </div>
                                        <input type="hidden" name="photo" value="<%= product.image %>">
                                        <div class="text-muted small">
                                            A imagem acima será enviada no seu canal.
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-8">
                                        <label for="caption" class="form-label text-white mb-2 fw-bold">Conteúdo da Postagem (Fique livre para editar!)</label>
                                        <textarea class="form-control form-control-lg mb-3 shadow-none lh-sm" id="caption" name="caption" rows="10" style="font-size: 15px;" required><%= product.caption %></textarea>
                                        
                                        <!-- Opções de Envio -->
                                        <div class="row mb-3 g-3">
                                            <div class="col-md-6">
                                                <div class="card p-3 border-secondary bg-dark bg-opacity-50">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input" type="checkbox" id="sendTelegram" name="sendTelegram" <%= config.telegram ? 'checked' : '' %>>
                                                        <label class="form-check-label text-white fw-bold" for="sendTelegram">
                                                            <i class="bi bi-telegram text-info me-1"></i> Enviar p/ Telegram
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="card p-3 border-secondary bg-dark bg-opacity-50">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input" type="checkbox" id="sendWhatsApp" name="sendWhatsApp" <%= config.whatsapp ? 'checked' : '' %>>
                                                        <label class="form-check-label text-white fw-bold" for="sendWhatsApp">
                                                            <i class="bi bi-whatsapp text-success me-1"></i> Enviar p/ WhatsApp
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- ID do Grupo WhatsApp (Opcional - sobrescreve o .env) -->
                                        <div class="mb-3" id="whatsappGroupContainer" style="display: none;">
                                            <label class="form-label text-white small fw-bold">ID do Grupo WhatsApp (Opcional)</label>
                                            <input type="text" class="form-control" name="whatsappGroup" placeholder="Ex: 120363024800@g.us">
                                            <div class="text-muted" style="font-size: 11px;">
                                                Dica: Geralmente é um número longo seguido de @g.us. Se o Bot já estiver em grupos, olhe o terminal do VS Code.
                                            </div>
                                        </div>
                                        
                                        <div class="alert alert-warning bg-warning bg-opacity-10 border-warning text-warning small p-2 mb-3">
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i> <b>Cuidado:</b> Use apenas tags suportadas (b, s, i, a, code).
                                        </div>

                                        <button type="submit" class="btn btn-success px-4 py-3 fw-bold w-100 fs-5 shadow">
                                            <i class="bi bi-send-fill me-2"></i> Postar nas Redes Selecionadas
                                        </button>
                                    </div>

                            <script>
                                // Mostrar/Esconder campo de ID do WhatsApp baseado no Checkbox
                                document.getElementById('sendWhatsApp').addEventListener('change', function() {
                                    document.getElementById('whatsappGroupContainer').style.display = this.checked ? 'block' : 'none';
                                });
                            </script>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
