# ---------------------------------------------------------------------------
# Bot de divulgação (Node.js)
# Copie para .env e preencha. Este arquivo é lido em tempo de execução pelo
# docker-compose (env_file) — não vai mais para dentro da imagem.
# ---------------------------------------------------------------------------

PORT=3005
TZ=America/Sao_Paulo

# --- Autenticação do painel do bot ---
ADMIN_USERNAME=admin
# Obrigatória. Sem ela o bot gera uma senha aleatória e imprime no log.
ADMIN_PASSWORD=
# Gere com: openssl rand -hex 32
SESSION_SECRET=

# --- Token compartilhado com o portal Python ---
# Protege /api/post-deal, /api/bot-settings e /api/metrics.
# Precisa ser IDÊNTICO ao BOT_API_TOKEN do web_scraping/.env.local.
# Gere com: openssl rand -hex 32
BOT_API_TOKEN=

# Origens liberadas para CORS (separadas por vírgula). Vazio = nenhuma.
# Ex.: http://SEU_IP:5000,https://ofertas.seudominio.com.br
ALLOWED_ORIGINS=

# Marque como true apenas se houver HTTPS (proxy reverso) na frente.
BOT_HTTPS=false

# --- Transporte do WhatsApp ---
# baileys (padrão) = sessão dentro deste processo, lida o QR Code no painel.
#                    É o único que funciona no modo portátil (pendrive).
# http             = manda por um gateway externo (Evolution API, WAHA, Z-API…).
#                    A sessão passa a viver fora daqui e sobrevive a um restart
#                    do bot. Exige Docker ou assinatura, então serve para VPS.
# nenhum           = desliga o WhatsApp; o Telegram continua publicando normal.
#
# Nota: a API oficial da Meta (Cloud API) NÃO envia mensagem para grupo, por
# isso ela não aparece aqui. Só faria sentido se a base virasse uma lista de
# assinantes com opt-in, um para um.
WA_TRANSPORTE=baileys

# Usados apenas quando WA_TRANSPORTE=http. O corpo é montado no formato da
# Evolution API; gateway com contrato diferente pede ajuste em
# transportes/http.js > montarCorpo.
WA_HTTP_URL=
WA_HTTP_URL_IMAGEM=
WA_HTTP_URL_GRUPOS=
WA_HTTP_TOKEN=
WA_HTTP_HEADER_TOKEN=apikey

# --- Credenciais de disparo (opcionais aqui) ---
# Servem como valor inicial. O que for salvo pela tela "Conexão & Afiliados"
# fica no banco em ./data/settings.db e tem prioridade sobre estas variáveis.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_CHAT_ID=
