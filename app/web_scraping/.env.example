# ---------------------------------------------------------------------------
# Portal de raspagem (Python / Flask)
# Copie para .env.local e preencha.
# ---------------------------------------------------------------------------

# --- Acesso ao portal ---
PORTAL_USERNAME=Admin
# Obrigatória. Sem ela o portal gera uma senha aleatória e imprime no log.
PORTAL_PASSWORD=
# Gere com: openssl rand -hex 32
SECRET_KEY=
# Marque como true apenas se houver HTTPS (proxy reverso) na frente.
PORTAL_HTTPS=false

# --- Integração com o bot ---
BOT_API_URL=http://bot-service:3005
# Precisa ser IDÊNTICO ao BOT_API_TOKEN do bot-divulgar-produtos/.env
BOT_API_TOKEN=

# ---------------------------------------------------------------------------
# Anti-bloqueio (Mercado Livre, Amazon, Shopee, AliExpress, KaBuM!)
# ---------------------------------------------------------------------------

# KaBuM! e AliExpress entregam o catálogo numa requisição comum, sem precisar de
# navegador — com isso a busca nessas lojas cai de ~15s para ~2s. Só desligue
# para depurar: com 0 o programa abre o Firefox para todas as lojas.
SCRAPER_HTTP_FIRST=true

# --- Shopee: API oficial de Afiliados ---
# A Shopee decide pelo IP antes de olhar o navegador e barra rede corporativa,
# institucional ou de datacenter — com a janela visível dá no mesmo. Com estas
# chaves o portal usa a API de afiliados, que responde de qualquer rede e já
# devolve o link afiliado pronto. Pegue em affiliate.shopee.com.br > Open API.
#
# Também dá para preencher pela tela de configuração do portal (fica salvo no
# banco do bot); estas variáveis têm prioridade sobre o que estiver lá.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Proxy de saída. ESTE É O ITEM QUE RESOLVE O BLOQUEIO NA VPS.
# ML e Amazon barram faixas de IP de datacenter na entrada, antes mesmo de
# olhar o navegador. Use um proxy residencial ou móvel brasileiro.
# Formato: http://usuario:senha@host:porta  (ou socks5://...)
SCRAPER_PROXY=

# Quantas vezes repetir quando o site devolver CAPTCHA (com backoff exponencial).
SCRAPER_MAX_ATTEMPTS=3

# Guarda cookies entre buscas em data/profiles — um visitante recorrente é
# menos suspeito que uma sessão nova a cada requisição.
SCRAPER_PERSIST_PROFILE=true

# Bloqueia imagens e fontes para gastar menos banda de proxy pago.
# Deixe desligado se não usar proxy: o padrão de requisição fica mais natural.
SCRAPER_LIGHT_MODE=false

# Sobrescreve o User-Agent. Por padrão ele é montado a partir do SO e da versão
# reais do Firefox — não mexa sem necessidade, um UA incoerente com
# navigator.platform é o sinal de bot mais fácil de detectar.
SCRAPER_USER_AGENT=

# --- Ritmo de publicação em lote (segundos entre mensagens) ---
# Valores baixos aceleram o ban do número no WhatsApp.
PUBLISH_MIN_DELAY=6
PUBLISH_MAX_DELAY=14
